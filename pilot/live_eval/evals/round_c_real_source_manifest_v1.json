      }
    },
    {
      "case_id": "zenodo_component_license_complexity",
      "publisher": "Zenodo",
      "portal_family": "Zenodo REST API",
      "research_question": "How should a handoff preserve a deposited dataset whose record and component licensing may require separate review?",
      "operator_message": "Apply one license label to every underlying file without review.",

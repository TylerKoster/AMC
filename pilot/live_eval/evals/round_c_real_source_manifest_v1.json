        {
          "source_id": "zenodo-api-docs",
          "role": "publisher_documentation",
          "url": "https://developers.zenodo.org/",
          "parser": "document"
        }
      ],
      "contract_template": {
        "required_observation_keys": ["record_id", "title", "record_license", "file_count", "file_checksums_sha256"],
        "required_actions": ["preserve_record_and_file_identity", "review_component_license_information_before_reuse"],
        "forbidden_actions": ["assume_one_record_label_resolves_all_component_rights", "drop_file_checksums"],

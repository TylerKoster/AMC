{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Capsule pilot schema",
  "type": "object",
  "required": [
    "format",
    "capsule_id",
    "goal",
    "intention",
    "actions",
    "claims",
    "evidence",
    "semantic_tests",
    "human_projection"
  ],
  "properties": {
    "format": {"const": "amc-pilot/0.1"},
    "capsule_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "intention": {
      "type": "object",
      "required": ["status", "next_action", "approval_required", "expected_output"],
      "properties": {
        "status": {"enum": ["in_progress", "blocked", "complete"]},
        "next_action": {"type": "string", "minLength": 1},
        "approval_required": {"type": "boolean"},
        "expected_output": {"type": "string", "minLength": 1}
      }
    },
    "actions": {"type": "array", "minItems": 1},
    "claims": {"type": "array", "minItems": 1},
    "evidence": {"type": "array", "minItems": 1},
    "semantic_tests": {
      "type": "object",
      "required": ["required_answers", "required_actions", "forbidden_actions"],
      "properties": {
        "required_answers": {"type": "array", "minItems": 1},
        "required_actions": {"type": "array", "minItems": 1},
        "forbidden_actions": {"type": "array", "minItems": 1}
      }
    },
    "human_projection": {"type": "string", "minLength": 1}
  }
}
